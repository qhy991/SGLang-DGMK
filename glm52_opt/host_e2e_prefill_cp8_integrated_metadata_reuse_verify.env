# Correctness-only variant of the Ariadne metadata-reuse candidate. It
# recomputes local valid lengths in every layer and compares them with the
# cached first-layer vector. Do not use this file for performance timing.
SGLANG_GLM52_OPT=1
SGLANG_GLM52_OPT_PROFILE=serving_safe
SGLANG_GLM52_E2E_PREFILL_INDEXER=1
SGLANG_GLM52_E2E_PREFILL_WORKSPACE=0
SGLANG_GLM52_E2E_PREFILL_CLUSTERED_MQA=1
SGLANG_GLM52_E2E_PREFILL_PAGED_MQA=1
SGLANG_GLM52_CP8_COMBINE_INDEXER_HALVES=1
SGLANG_GLM52_CP8_PACKED_KV_COMM=0
SGLANG_GLM52_CP8_DIRECT_PACKED_KV_COMM=1
SGLANG_GLM52_CP8_REUSE_FLASHMLA_METADATA=1
SGLANG_GLM52_CP8_REUSE_FLASHMLA_METADATA_VERIFY=1
SGLANG_JIT_DEEPGEMM_PRECOMPILE=0
