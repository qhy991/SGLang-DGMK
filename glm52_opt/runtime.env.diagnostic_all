# Exhaustive GLM-5.2 operator interception profile.
# Keep one canonical op per performance run.  "all" is only for reachability
# smoke tests because simultaneous swaps cannot attribute a gain/regression.
SGLANG_GLM52_OPT=1
SGLANG_GLM52_OPT_PROFILE=diagnostic_all
SGLANG_GLM52_OPT_OPS=o_proj
SGLANG_GLM52_OPT_M_BUCKETS=o_proj:16|32
SGLANG_GLM52_ALLOW_ABI_ADAPTER=0
SGLANG_GLM52_INFINI_KERNEL_NVTX=1
SGLANG_GLM52_OPT_HIT_FILE=/tmp/glm52_diagnostic_hits.json

# Required only for provider-backed ops:
# dsa_decode_attn,index_wk_weights_proj,moe_gate_proj(decode),
# moe_swiglu_quant,moe_down_proj(decode),router_logit_gemm,
# router_sigmoid_topk
# SGLANG_GLM52_HOTSPOT_MODULE=/absolute/path/to/provider.py
