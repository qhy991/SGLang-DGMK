# GLM-5.2 e2e candidate profile (NOT production default).
# Point SGLANG_GLM52_ENV_FILE at this file, then restart serve.
SGLANG_GLM52_OPT=1
SGLANG_GLM52_OPT_PROFILE=e2e_candidates
# Default e2e set when OPT_OPS is empty: o_proj + MoE PSUM prefill.
# Narrow for ablation, e.g. SGLANG_GLM52_OPT_OPS=o_proj
# SGLANG_GLM52_OPT_OPS=o_proj,moe_gate_proj,moe_down_proj
SGLANG_GLM52_OPT_M_BUCKETS=o_proj:16|32
SGLANG_GLM52_ALLOW_ABI_ADAPTER=0
