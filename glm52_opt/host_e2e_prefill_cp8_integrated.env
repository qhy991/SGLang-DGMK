# Frozen integrated GLM-5.2 CP8/EP8 90K-cache + 10K-input prefill arm.
#
# This is the single runtime profile for the integrated candidate.  The host
# launcher additionally freezes zigzag CP8, DeepEP120, the balanced expert map,
# and router static-placement fusion because those are server arguments rather
# than glm52_opt environment switches.
SGLANG_GLM52_OPT=1
SGLANG_GLM52_OPT_PROFILE=serving_safe
SGLANG_GLM52_E2E_PREFILL_INDEXER=1
SGLANG_GLM52_E2E_PREFILL_WORKSPACE=0
SGLANG_GLM52_E2E_PREFILL_CLUSTERED_MQA=1
SGLANG_GLM52_E2E_PREFILL_PAGED_MQA=1
SGLANG_GLM52_CP8_COMBINE_INDEXER_HALVES=1
SGLANG_GLM52_CP8_PACKED_KV_COMM=0
SGLANG_GLM52_CP8_DIRECT_PACKED_KV_COMM=1
SGLANG_JIT_DEEPGEMM_PRECOMPILE=0
