 namespace sm100::decode::head64 {

+// kernel_h_q is 64 for both native H64 and each rewritten half of H128.
+inline constexpr bool use_glm52_flat_token_index(
+    int original_h_q,
+    int kernel_h_q,
+    int s_q,
+    int d_qk,
+    int topk,
+    int page_block_size,
+    int64_t stride_kv_row,
+    int64_t stride_kv_block,
+    int extra_topk,
+    bool has_topk_length,
+    bool has_extra_topk_length,
+    bool has_attn_sink
+) {
+    constexpr int BYTES_PER_TOKEN = 656;
+    return original_h_q == 64 && kernel_h_q == 64 && s_q == 1 && d_qk == 576 &&
+        topk == 2048 && page_block_size == 64 &&
+        stride_kv_row == BYTES_PER_TOKEN &&
+        stride_kv_block == 64 * BYTES_PER_TOKEN && extra_topk == 0 &&
+        !has_topk_length && !has_extra_topk_length && !has_attn_sink;
+}
+
+static_assert(use_glm52_flat_token_index(
+    64, 64, 1, 576, 2048, 64, 656, 64 * 656, 0, false, false, false
+));
+static_assert(!use_glm52_flat_token_index(
+    128, 64, 1, 576, 2048, 64, 656, 64 * 656, 0, false, false, false
+));
+static_assert(!use_glm52_flat_token_index(
+    64, 64, 2, 576, 2048, 64, 656, 64 * 656, 0, false, false, false
+));
+static_assert(!use_glm52_flat_token_index(
+    64, 64, 1, 576, 2048, 64, 656, 65 * 656, 0, false, false, false
+));
+
 template<ModelType MODEL_TYPE>
-void run_flash_splitkv_mla_fp8_sparse_kernel(const SparseAttnDecodeParams &params);
+void run_flash_splitkv_mla_fp8_sparse_kernel(const SparseAttnDecodeParams &params, int original_h_q);

 }
